<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur10_peg_task">

  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur10"/>
  <xacro:arg name="sim_gazebo" default="true"/>
  <xacro:arg name="simulation_controllers" default="$(find ur_simulation_gazebo)/config/ur_controllers.yaml"/>

  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>

  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table_link"/>
    <origin xyz="0.7 0 0" rpy="0 0 0"/>
  </joint>

  <link name="table_link">
    <visual>
      <origin xyz="0 0 0.775"/>
      <geometry><box size="0.6 1.0 0.05"/></geometry>
      <material name="wood"><color rgba="0.6 0.4 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.775"/>
      <geometry><box size="0.6 1.0 0.05"/></geometry>
    </collision>

    <visual><origin xyz="0.25 0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry><material name="wood"/></visual>
    <collision><origin xyz="0.25 0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry></collision>
    
    <visual><origin xyz="-0.25 0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry><material name="wood"/></visual>
    <collision><origin xyz="-0.25 0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry></collision>
    
    <visual><origin xyz="0.25 -0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry><material name="wood"/></visual>
    <collision><origin xyz="0.25 -0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry></collision>
    
    <visual><origin xyz="-0.25 -0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry><material name="wood"/></visual>
    <collision><origin xyz="-0.25 -0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry></collision>

    <inertial>
      <origin xyz="0 0 0.4"/>
      <mass value="20"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>

  <joint name="table_to_plate" type="fixed">
    <parent link="table_link"/>
    <child link="plate_link"/>
    <origin xyz="0 -0.25 0.95" rpy="0 -1.5708 1.5708"/>
  </joint>

  <link name="plate_link">
    <visual><origin xyz="0.085 0 0"/><geometry><box size="0.13 0.3 0.02"/></geometry><material name="grey"><color rgba="0.3 0.3 0.3 1"/></material></visual>
    <collision><origin xyz="0.085 0 0"/><geometry><box size="0.13 0.3 0.02"/></geometry></collision>
    
    <visual><origin xyz="-0.085 0 0"/><geometry><box size="0.13 0.3 0.02"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="-0.085 0 0"/><geometry><box size="0.13 0.3 0.02"/></geometry></collision>
    
    <visual><origin xyz="0 0.085 0"/><geometry><box size="0.04 0.13 0.02"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0.085 0"/><geometry><box size="0.04 0.13 0.02"/></geometry></collision>
    
    <visual><origin xyz="0 -0.085 0"/><geometry><box size="0.04 0.13 0.02"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 -0.085 0"/><geometry><box size="0.04 0.13 0.02"/></geometry></collision>

    <inertial>
      <mass value="1"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <gazebo reference="table_link"><material>Gazebo/Wood</material></gazebo>
  <gazebo reference="plate_link"><material>Gazebo/DarkGrey</material></gazebo>

  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro"/>
  
  <xacro:robotiq_gripper name="RobotiqGripper" prefix="" parent="tool0" include_ros2_control="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper>

  <ros2_control name="RobotiqGripperHardware" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="robotiq_85_left_knuckle_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.8</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
